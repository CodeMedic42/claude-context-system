{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "2.1.0",
  "npmClient": "pnpm",
  "packages": [
    "claude-plugin",
    "test-runner"
  ],
  "command": {
    "version": {
      "allowBranch": [
        "master",
        "main"
      ],
      "conventionalCommits": false,
      "exact": true,
      "message": "chore(release): publish %s"
    },
    "publish": {
      "ignoreChanges": [
        "*.md",
        "**/*.md",
        "**/test/**",
        "**/__tests__/**"
      ],
      "message": "chore(release): publish %s"
    }
  }
}