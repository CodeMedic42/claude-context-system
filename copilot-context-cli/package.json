{
  "name": "copilot-context-cli",
  "version": "2.1.0",
  "description": "GitHub Copilot CLI tool for managing claude.md context files - equivalent functionality to Claude Code plugin",
  "main": "index.js",
  "bin": {
    "copilot-plugin": "./bin/copilot-plugin.js"
  },
  "scripts": {
    "template:update": "cp -r ../shared/templates/* ./templates/",
    "command:update": "cp -r ../shared/commands/* ./commands/",
    "sync": "npm run template:update && npm run command:update"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "cli",
    "context-management",
    "documentation",
    "ai-assistant",
    "claude.md"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/claude-context-system",
    "directory": "copilot-context-cli"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "@github/copilot": "*"
  }
}
