{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug plugin:library-package",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/share/fnm/aliases/default/bin/node",
      "program": "${workspaceFolder}/tests/cli/bin/contest.js",
      "args": [ "test", "--tools", "plugin", "--plans", "library-package", "--prepare-only" ],
      "console": "integratedTerminal",
      "skipFiles": [ "<node_internals>/**" ],
      "env": { "NODE_ENV": "development" },
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    },
    {
      "name": "Debug plugin:angular-components",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/share/fnm/aliases/default/bin/node",
      "program": "${workspaceFolder}/tests/cli/bin/contest.js",
      "args": [ "test", "--tools", "plugin", "--plans", "angular-components", "--prepare-only" ],
      "console": "integratedTerminal",
      "skipFiles": [ "<node_internals>/**" ],
      "env": { "NODE_ENV": "development" },
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    },

    {
      "name": "Debug plugin:facebook-react",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/share/fnm/aliases/default/bin/node",
      "program": "${workspaceFolder}/tests/cli/bin/contest.js",
      "args": [ "test", "--tools", "plugin", "--plans", "facebook-react", "--prepare-only" ],
      "console": "integratedTerminal",
      "skipFiles": [ "<node_internals>/**" ],
      "env": { "NODE_ENV": "development" },
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    },
    {
      "name": "Debug Re-run Last Test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/share/fnm/aliases/default/bin/node",
      "program": "${workspaceFolder}/tests/cli/bin/contest.js",
      "args": [
        "rerun",
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    }
  ]
}
