{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug claude:dotnet-update Test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/.local/share/fnm/aliases/default/bin/node",
      "program": "${workspaceFolder}/tests/run-tests.js",
      "args": [
        "plan=dotnet-update",
        "tool=plugin"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "cwd": "${workspaceFolder}",
      "outputCapture": "std"
    },
    {
      "name": "Debug copilot:library-package Test",
