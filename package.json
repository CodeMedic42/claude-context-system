{
  "name": "claude-context-system",
  "version": "2.0.0",
  "description": "Automated claude.md context file manager for AI assistants - supports Claude Code and GitHub Copilot",
  "private": true,
  "keywords": [
    "claude-code",
    "github-copilot",
    "context-management",
    "documentation",
    "ai-assistant",
    "monorepo",
    "claude.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/claude-context-system"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lerna": "^9.0.3",
    "node-pty": "^1.1.0",
    "picocolors": "^1.1.1"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "lerna clean -y",
    "contest": "node tests/cli/bin/contest.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "build": "lerna run build",
    "version": "lerna version",
    "publish:commit": "lerna publish",
    "publish:canary": "lerna publish --canary",
    "changed": "lerna changed",
    "diff": "lerna diff",
    "exec": "lerna exec",
    "sync": "pnpm run version:sync && pnpm run plugin:sync && pnpm run copilot:sync",
    "version:sync": "node plugin-setup/sync-version.js",
    "plugin:install": "node plugin-setup/plugin-install.js",
    "plugin:uninstall": "node plugin-setup/plugin-uninstall.js",
    "plugin:sync": "node plugin-setup/sync-plugin-git.js",
    "plugin:sync:local": "node plugin-setup/sync-plugin-local.js",
    "plugin:reinstall": "pnpm run plugin:uninstall && pnpm run plugin:sync:local && pnpm run plugin:install",
    "copilot:sync": "node plugin-setup/sync-copilot.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3",
    "inquirer": "^8.2.7",
    "lodash": "^4.17.21",
    "open": "^8.4.2",
    "strip-ansi": "^6.0.1"
  }
}
