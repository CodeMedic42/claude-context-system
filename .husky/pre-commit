#!/bin/sh

# Simple pre-commit check: Ensure plugin directories match shared directory

check_directory_sync() {
    local shared_dir="$1"
    local plugin_dir="$2"
    local errors_found=0

    # Check all files in shared directory
    if [ -d "$shared_dir" ]; then
        find "$shared_dir" -type f | while read -r shared_file; do
            relative_path="${shared_file#$shared_dir/}"
            plugin_file="$plugin_dir/$relative_path"

            # Check if file exists in plugin directory (case-insensitive)
            if [ ! -f "$plugin_file" ]; then
                # Try case-insensitive match
                plugin_file_lower=$(find "$plugin_dir" -maxdepth 1 -type f -iname "$(basename "$relative_path")" 2>/dev/null | head -n 1)
                if [ -z "$plugin_file_lower" ]; then
                    echo "  ❌ Missing file: $plugin_file"
                    errors_found=1
                    continue
                fi
                plugin_file="$plugin_file_lower"
            fi

            # Compare file contents
            if ! cmp -s "$shared_file" "$plugin_file"; then
                echo "  ❌ Content mismatch: $plugin_file"
                errors_found=1
            fi
        done
        [ $errors_found -eq 1 ] && return 1
    fi

    # Check for extra files in plugin directory that don't exist in shared
    if [ -d "$plugin_dir" ]; then
        find "$plugin_dir" -type f | while read -r plugin_file; do
            relative_path="${plugin_file#$plugin_dir/}"
            shared_file="$shared_dir/$relative_path"

            # Check if file exists in shared directory (case-insensitive)
            if [ ! -f "$shared_file" ]; then
                # Try case-insensitive match
                shared_file_lower=$(find "$shared_dir" -maxdepth 1 -type f -iname "$(basename "$relative_path")" 2>/dev/null | head -n 1)
                if [ -z "$shared_file_lower" ]; then
                    echo "  ❌ Extra file not in shared: $plugin_file"
                    errors_found=1
                fi
            fi
        done
        [ $errors_found -eq 1 ] && return 1
    fi

    return 0
}

has_errors=0

# Check claude-context-plugin/commands
echo "Checking claude-context-plugin/commands..."
if ! check_directory_sync "shared/commands" "claude-context-plugin/commands"; then
    has_errors=1
fi

# Check claude-context-plugin/templates
echo "Checking claude-context-plugin/templates..."
if ! check_directory_sync "shared/templates" "claude-context-plugin/templates"; then
    has_errors=1
fi

# Check copilot-context-cli/commands
echo "Checking copilot-context-cli/commands..."
if ! check_directory_sync "shared/commands" "copilot-context-cli/commands"; then
    has_errors=1
fi

# Check copilot-context-cli/templates
echo "Checking copilot-context-cli/templates..."
if ! check_directory_sync "shared/templates" "copilot-context-cli/templates"; then
    has_errors=1
fi

if [ $has_errors -eq 1 ]; then
    echo ""
    echo "❌ ERROR: The contents of claude-context-plugin and copilot-context-cli do not match the shared folder."
    echo ""
    echo "Please run: pnpm run sync"
    echo ""
    exit 1
fi

echo "✅ All directories are in sync"
exit 0
